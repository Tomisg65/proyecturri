---
const pageTitle = "CR7 - Datos y Estadísticas Globales";

// Métricas Generales (KPIs)
const kpis = [
    { valor: "970+", label: "Goles Totales en Carrera", icono: "⚽" },
    { valor: "1,330+", label: "Partidos Oficiales", icono: "🏟️" },
    { valor: "290+", label: "Asistencias Proporcionadas", icono: "🎯" },
    { valor: "0.73", label: "Promedio de Goles / Partido", icono: "📊" },
];

// Desglose de Goles por Equipo
const golesPorEquipo = [
    {
        equipo: "Real Madrid",
        partidos: 438,
        goles: 450,
        asistencias: 131,
        promedio: "1.03",
        color: "#3b82f6",
    },
    {
        equipo: "Selección de Portugal",
        partidos: 234,
        goles: 146,
        asistencias: 45,
        promedio: "0.62",
        color: "#da291c",
    },
    {
        equipo: "Manchester United",
        partidos: 346,
        goles: 145,
        asistencias: 64,
        promedio: "0.42",
        color: "#ef4444",
    },
    {
        equipo: "Al-Nassr FC",
        partidos: 155,
        goles: 132,
        asistencias: 23,
        promedio: "0.85",
        color: "#eab308",
    },
    {
        equipo: "Juventus FC",
        partidos: 134,
        goles: 101,
        asistencias: 22,
        promedio: "0.75",
        color: "#94a3b8",
    },
    {
        equipo: "Sporting CP",
        partidos: 31,
        goles: 5,
        asistencias: 6,
        promedio: "0.16",
        color: "#10b981",
    },
];

// Datos Físicos y Registro Atlántico
const datosFisicos = [
    { dato: "1.87 m", concepto: "Estatura", icono: "📏" },
    { dato: "83 kg", concepto: "Peso Competitivo", icono: "⚖️" },
    { dato: "78 cm", concepto: "Salto Vertical Estático", icono: "🚀" },
    { dato: "33.6 km/h", concepto: "Velocidad Máxima Registrada", icono: "⚡" },
    { dato: "2.93 m", concepto: "Altura Máxima Remate Cabeza", icono: "💥" },
    { dato: "7%", concepto: "Grasa Corporal Promedio", icono: "💪" },
];

// Récords Históricos Destacados
const rcordsDestacados = [
    "Máximo goleador histórico en el fútbol profesional masculino.",
    "Máximo goleador de la historia en selecciones nacionales de fútbol.",
    "Máximo goleador histórico de la UEFA Champions League (140 goles).",
    "Primer jugador en anotar en 5 ediciones distintas de la Copa Mundial de Fútbol.",
    "Primer futbolista en superar los 100 goles en tres ligas europeas distintas (Inglaterra, España e Italia).",
    "Más hat-tricks (3 o más goles) anotados en la historia del fútbol profesional.",
];
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <title>{pageTitle}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href="src/styles/global.css" />
        <link
            href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;700;900&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <!-- Navbar -->
        <header class="navbar">
            <div class="logo">
                <a href="/">CR<span>7</span></a>
            </div>
            <nav class="nav-links">
                <a href="/">Inicio</a>
                <a href="/equipos">Equipos</a>
                <a href="/trofeos">Trofeos</a>
                <a href="/datos" class="active">Datos & Stats</a>
            </nav>
        </header>

        <main class="container">
            <section class="page-header">
                <p class="subtitle">ESTADÍSTICAS Y MÉTRICAS</p>
                <h1>EL ATLETA Y SUS <span class="gold-text">NÚMEROS</span></h1>
                <p class="description">
                    Análisis completo del rendimiento goleador, registros
                    físicos y récords Guinness a lo largo de su carrera.
                </p>
            </section>

            <!-- KPI Grid -->
            <section class="kpi-grid">
                {
                    kpis.map((kpi) => (
                        <div class="kpi-card">
                            <span class="kpi-icon">{kpi.icono}</span>
                            <span class="kpi-value">{kpi.valor}</span>
                            <span class="kpi-label">{kpi.label}</span>
                        </div>
                    ))
                }
            </section>

            <!-- Tabla de Goles por Club y Selección -->
            <section class="section-block">
                <h2 class="section-title">
                    <span>⚽</span> Registro de Goles y Asistencias por Equipo
                </h2>
                <div class="table-container">
                    <table class="stats-table">
                        <thead>
                            <tr>
                                <th>Equipo</th>
                                <th>Partidos</th>
                                <th>Goles</th>
                                <th>Asistencias</th>
                                <th>Promedio G/P</th>
                            </tr>
                        </thead>
                        <tbody>
                            {
                                golesPorEquipo.map((row) => (
                                    <tr>
                                        <td class="team-cell">
                                            <span
                                                class="color-dot"
                                                style={`background-color: ${row.color}`}
                                            />
                                            <strong>{row.equipo}</strong>
                                        </td>
                                        <td>{row.partidos}</td>
                                        <td class="gold-bold">{row.goles}</td>
                                        <td>{row.asistencias}</td>
                                        <td>
                                            <span class="badge-avg">
                                                {row.promedio}
                                            </span>
                                        </td>
                                    </tr>
                                ))
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- Grid Datos Físicos y Atléticos -->
            <section class="section-block">
                <h2 class="section-title">
                    <span>⚡</span> Atletismo y Capacidades Físicas
                </h2>
                <div class="physical-grid">
                    {
                        datosFisicos.map((item) => (
                            <div class="physical-card">
                                <span class="p-icon">{item.icono}</span>
                                <div class="p-info">
                                    <span class="p-value">{item.dato}</span>
                                    <span class="p-concept">
                                        {item.concepto}
                                    </span>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </section>

            <!-- Lista de Récords Históricos -->
            <section class="section-block">
                <h2 class="section-title">
                    <span>🏆</span> Récords Históricos Insuperables
                </h2>
                <ul class="records-list">
                    {
                        rcordsDestacados.map((record) => (
                            <li class="record-item">
                                <span class="check-icon">✓</span>
                                <p>{record}</p>
                            </li>
                        ))
                    }
                </ul>
            </section>

            <!-- Navegación Inferior -->
            <div class="bottom-nav">
                <a href="/trofeos" class="btn btn-outline">&larr; Ver Trofeos</a
                >
                <a href="/equipos" class="btn btn-gold"
                    >Ver Todos los Equipos &rarr;</a
                >
            </div>
        </main>

        <footer>
            <p>&copy; 2026 CR7 Fan Page - Creado con Astro</p>
        </footer>
    </body>
</html>
<style>
    /* --- VARIABLES Y COLORES --- */
    :root {
        --cr7-red: #da291c;
        --cr7-gold: #d4af37;
        --cr7-dark: #0a0e17;
        --cr7-card-bg: #141b2d;
        --cr7-text: #ffffff;
        --cr7-text-muted: #a0aec0;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: "Montserrat", sans-serif;
    }

    body {
        background-color: var(--cr7-dark);
        color: var(--cr7-text);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    /* NAVBAR */
    .navbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.5rem 5%;
        background-color: rgba(10, 14, 23, 0.95);
        backdrop-filter: blur(10px);
        position: sticky;
        top: 0;
        z-index: 100;
        border-bottom: 1px solid rgba(212, 175, 55, 0.2);
    }

    .logo a {
        font-size: 2rem;
        font-weight: 900;
        color: var(--cr7-text);
        text-decoration: none;
    }

    .logo span {
        color: var(--cr7-red);
    }

    .nav-links {
        display: flex;
        gap: 2rem;
    }

    .nav-links a {
        color: var(--cr7-text-muted);
        text-decoration: none;
        font-weight: 700;
        font-size: 0.9rem;
        text-transform: uppercase;
        transition: color 0.3s ease;
    }

    .nav-links a:hover,
    .nav-links a.active {
        color: var(--cr7-gold);
    }

    /* CONTAINER */
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 3rem 1.5rem;
        width: 100%;
    }

    .page-header {
        text-align: center;
        margin-bottom: 3.5rem;
    }

    .subtitle {
        color: var(--cr7-red);
        font-weight: 900;
        letter-spacing: 2px;
        font-size: 0.85rem;
        margin-bottom: 0.5rem;
    }

    .page-header h1 {
        font-size: 3rem;
        font-weight: 900;
        text-transform: uppercase;
        margin-bottom: 1rem;
    }

    .gold-text {
        background: linear-gradient(45deg, #d4af37, #fff2a8, #aa7c11);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .description {
        color: var(--cr7-text-muted);
        max-width: 600px;
        margin: 0 auto;
        font-size: 1rem;
    }

    /* KPI GRID */
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1.5rem;
        margin-bottom: 4rem;
    }

    .kpi-card {
        background: linear-gradient(145deg, #182239, #0f172a);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 1.8rem 1rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .kpi-icon {
        font-size: 2rem;
        margin-bottom: 0.5rem;
    }

    .kpi-value {
        font-size: 2.5rem;
        font-weight: 900;
        color: var(--cr7-gold);
        line-height: 1.1;
    }

    .kpi-label {
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--cr7-text-muted);
        margin-top: 0.5rem;
    }

    /* SECTION BLOCK */
    .section-block {
        margin-bottom: 4rem;
    }

    .section-title {
        font-size: 1.5rem;
        font-weight: 900;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.8rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        padding-bottom: 0.8rem;
    }

    /* STATS TABLE */
    .table-container {
        overflow-x: auto;
        background-color: var(--cr7-card-bg);
        border-radius: 8px;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .stats-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
        font-size: 0.95rem;
    }

    .stats-table th {
        background-color: rgba(0, 0, 0, 0.3);
        color: var(--cr7-text-muted);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 1rem 1.2rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .stats-table td {
        padding: 1rem 1.2rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }

    .stats-table tr:last-child td {
        border-bottom: none;
    }

    .team-cell {
        display: flex;
        align-items: center;
        gap: 0.8rem;
    }

    .color-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
    }

    .gold-bold {
        color: var(--cr7-gold);
        font-weight: 700;
    }

    .badge-avg {
        background-color: rgba(255, 255, 255, 0.08);
        padding: 0.2rem 0.6rem;
        border-radius: 4px;
        font-weight: 700;
        font-size: 0.85rem;
    }

    /* PHYSICAL GRID */
    .physical-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.5rem;
    }

    .physical-card {
        background-color: var(--cr7-card-bg);
        border-radius: 8px;
        padding: 1.2rem;
        display: flex;
        align-items: center;
        gap: 1.2rem;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .p-icon {
        font-size: 2rem;
    }

    .p-info {
        display: flex;
        flex-direction: column;
    }

    .p-value {
        font-size: 1.3rem;
        font-weight: 900;
        color: var(--cr7-text);
    }

    .p-concept {
        font-size: 0.8rem;
        color: var(--cr7-text-muted);
        text-transform: uppercase;
    }

    /* RECORDS LIST */
    .records-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .record-item {
        background-color: var(--cr7-card-bg);
        border-radius: 8px;
        padding: 1.2rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        border-left: 3px solid var(--cr7-gold);
    }

    .check-icon {
        color: var(--cr7-gold);
        font-weight: 900;
        font-size: 1.2rem;
    }

    .record-item p {
        font-size: 0.95rem;
        color: #e2e8f0;
    }

    /* BOTONES */
    .bottom-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 2rem;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        padding: 0.9rem 1.8rem;
        font-size: 0.9rem;
        font-weight: 700;
        border-radius: 4px;
        text-decoration: none;
        text-transform: uppercase;
        transition: all 0.3s ease;
    }

    .btn-gold {
        background: linear-gradient(45deg, #d4af37, #b8860b);
        color: black;
    }

    .btn-outline {
        background: transparent;
        color: white;
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    .btn:hover {
        transform: translateY(-2px);
    }

    /* FOOTER */
    footer {
        text-align: center;
        padding: 2rem;
        background-color: #05070c;
        color: var(--cr7-text-muted);
        font-size: 0.85rem;
        margin-top: auto;
    }

    /* RESPONSIVE */
    @media (max-width: 768px) {
        .navbar {
            flex-direction: column;
            gap: 1rem;
        }

        .page-header h1 {
            font-size: 2.2rem;
        }

        .bottom-nav {
            flex-direction: column;
        }

        .bottom-nav .btn {
            width: 100%;
            justify-content: center;
        }
    }
</style>
