<style>
	/* --- VARIABLES Y COLORES CARACTERÍSTICOS --- */
	:root {
		--cr7-red: #da291c; /* Rojo Selección Portugal / Man Utd */
		--cr7-gold: #d4af37; /* Oro Balón de Oro / Éxito */
		--cr7-dark: #0a0e17; /* Azul muy oscuro (Champions League) */
		--cr7-card-bg: #141b2d; /* Fondo para tarjetas */
		--cr7-text: #ffffff; /* Texto principal */
		--cr7-text-muted: #a0aec0; /* Texto secundario */
	}

	/* RESET BÁSICO */
	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
		font-family: "Montserrat", sans-serif;
	}

	body {
		background-color: var(--cr7-dark);
		color: var(--cr7-text);
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	/* NAVBAR */
	.navbar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1.5rem 5%;
		background-color: rgba(10, 14, 23, 0.9);
		backdrop-filter: blur(10px);
		position: sticky;
		top: 0;
		z-index: 100;
		border-bottom: 1px solid rgba(212, 175, 55, 0.2);
	}

	.logo {
		font-size: 2rem;
		font-weight: 900;
		letter-spacing: -1px;
		color: var(--cr7-text);
	}

	.logo span {
		color: var(--cr7-red);
	}

	.nav-links {
		display: flex;
		gap: 2rem;
	}

	.nav-links a {
		color: var(--cr7-text-muted);
		text-decoration: none;
		font-weight: 700;
		font-size: 0.9rem;
		text-transform: uppercase;
		letter-spacing: 1px;
		transition: all 0.3s ease;
	}

	.nav-links a:hover,
	.nav-links a.active {
		color: var(--cr7-gold);
	}

	/* HERO SECTION */
	.hero {
		position: relative;
		min-height: 70vh;
		display: flex;
		align-items: center;
		padding: 0 8%;
		background:
			linear-gradient(
				135deg,
				rgba(10, 14, 23, 0.95) 0%,
				rgba(20, 27, 45, 0.8) 100%
			),
			url("https://images.unsplash.com/photo-1508098682722-e99c43a406b2?q=80&w=1200&auto=format&fit=crop")
				center/cover;
	}

	.hero-content {
		max-width: 700px;
		z-index: 2;
	}

	.subtitle {
		color: var(--cr7-red);
		font-size: 0.9rem;
		font-weight: 900;
		letter-spacing: 3px;
		margin-bottom: 0.5rem;
	}

	.hero h1 {
		font-size: 4rem;
		font-weight: 900;
		line-height: 1;
		margin-bottom: 1rem;
		text-transform: uppercase;
	}

	.gold-text {
		background: linear-gradient(45deg, #d4af37, #fff2a8, #aa7c11);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.tagline {
		font-size: 1.1rem;
		color: var(--cr7-text-muted);
		font-style: italic;
		margin-bottom: 2.5rem;
		border-left: 3px solid var(--cr7-red);
		padding-left: 1rem;
	}

	/* BOTONES */
	.btn-group {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.9rem 1.8rem;
		font-size: 0.95rem;
		font-weight: 700;
		border-radius: 4px;
		text-decoration: none;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.btn:hover {
		transform: translateY(-3px);
	}

	.btn-primary {
		background-color: var(--cr7-red);
		color: white;
		box-shadow: 0 4px 15px rgba(218, 41, 28, 0.4);
	}

	.btn-gold {
		background: linear-gradient(45deg, #d4af37, #b8860b);
		color: black;
		box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
	}

	.btn-outline {
		background: transparent;
		color: white;
		border: 2px solid white;
	}

	.btn-outline:hover {
		background: white;
		color: black;
	}

	/* CARDS SECTION */
	.cards-section {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 2rem;
		padding: 4rem 8%;
		margin-top: -3rem;
		z-index: 10;
		position: relative;
	}

	.card {
		background-color: var(--cr7-card-bg);
		border: 1px solid rgba(255, 255, 255, 0.05);
		padding: 2rem;
		border-radius: 8px;
		transition: border-color 0.3s ease;
	}

	.card:hover {
		border-color: var(--cr7-red);
	}

	.highlight-card {
		border-color: var(--cr7-gold);
	}

	.card-icon {
		font-size: 2.5rem;
		margin-bottom: 1rem;
	}

	.card h3 {
		font-size: 1.4rem;
		margin-bottom: 0.8rem;
	}

	.card p {
		color: var(--cr7-text-muted);
		font-size: 0.95rem;
		line-height: 1.5;
		margin-bottom: 1.5rem;
	}

	.card-link {
		color: var(--cr7-gold);
		text-decoration: none;
		font-weight: 700;
		font-size: 0.9rem;
	}

	.card-link:hover {
		text-decoration: underline;
	}

	/* FOOTER */
	footer {
		text-align: center;
		padding: 2rem;
		background-color: #05070c;
		color: var(--cr7-text-muted);
		font-size: 0.85rem;
		margin-top: auto;
	}

	/* RESPONSIVE (Móviles) */
	@media (max-width: 768px) {
		.navbar {
			flex-direction: column;
			gap: 1rem;
		}

		.hero h1 {
			font-size: 2.8rem;
		}

		.btn-group {
			flex-direction: column;
			width: 100%;
		}

		.btn {
			justify-content: center;
			width: 100%;
		}
	}
</style>
