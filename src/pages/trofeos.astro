---
const pageTitle = "CR7 - Palmarés y Trofeos";

// Resumen de trofeos principales (Actualizado: 3 Títulos con Selección)
const resumenTrofeos = [
    { cantidad: "5", titulo: "Balones de Oro", icono: "🥇" },
    { cantidad: "5", titulo: "Champions League", icono: "🏆" },
    { cantidad: "4", titulo: "Botas de Oro", icono: "👟" },
    { cantidad: "3", titulo: "Títulos Selección", icono: "🇵🇹" },
];

// Premios Individuales
const premiosIndividuales = [
    {
        nombre: "Balón de Oro",
        cantidad: 5,
        anos: "2008, 2013, 2014, 2016, 2017",
        icono: "🏅",
    },
    { nombre: "The Best FIFA", cantidad: 2, anos: "2016, 2017", icono: "⭐" },
    {
        nombre: "Bota de Oro Europea",
        cantidad: 4,
        anos: "2008, 2011, 2014, 2015",
        icono: "👟",
    },
    {
        nombre: "Mejor Jugador de la UEFA",
        cantidad: 3,
        anos: "2014, 2016, 2017",
        icono: "🎖️",
    },
    {
        nombre: "Máximo Goleador de la Champions",
        cantidad: 7,
        anos: "2008, 2013, 2014, 2015, 2016, 2017, 2018",
        icono: "⚽",
    },
];

// Títulos Internacionales (Actualizado con Nations League 2025)
const titulosSeleccion = [
    {
        torneo: "UEFA Nations League",
        cantidad: 2,
        anos: "2019, 2025",
        detalle: "Bicampeones de la Liga de Naciones de la UEFA",
    },
    {
        torneo: "Eurocopa UEFA",
        cantidad: 1,
        anos: "2016",
        detalle: "Primer gran título mayor en la historia de Portugal",
    },
];

// Títulos por Clubes
const titulosClubes = [
    {
        club: "Real Madrid",
        escudo: "👑",
        titulos: [
            { nombre: "UEFA Champions League", cantidad: 4 },
            { nombre: "LaLiga", cantidad: 2 },
            { nombre: "Copa del Rey", cantidad: 2 },
            { nombre: "Mundial de Clubes", cantidad: 3 },
            { nombre: "Supercopa de Europa", cantidad: 3 },
            { nombre: "Supercopa de España", cantidad: 2 },
        ],
    },
    {
        club: "Manchester United",
        escudo: "😈",
        titulos: [
            { nombre: "UEFA Champions League", cantidad: 1 },
            { nombre: "Premier League", cantidad: 3 },
            { nombre: "FA Cup", cantidad: 1 },
            { nombre: "EFL Cup (Copa de la Liga)", cantidad: 2 },
            { nombre: "Mundial de Clubes", cantidad: 1 },
            { nombre: "Community Shield", cantidad: 2 },
        ],
    },
    {
        club: "Juventus FC",
        escudo: "⚪⚫",
        titulos: [
            { nombre: "Serie A", cantidad: 2 },
            { nombre: "Coppa Italia", cantidad: 1 },
            { nombre: "Supercoppa Italiana", cantidad: 2 },
        ],
    },
    {
        club: "Sporting CP & Al-Nassr",
        escudo: "⚽",
        titulos: [
            { nombre: "Supertaça de Portugal (Sporting)", cantidad: 1 },
            { nombre: "Campeonato de Clubes Árabes (Al-Nassr)", cantidad: 1 },
        ],
    },
];
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <title>{pageTitle}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;700;900&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <!-- Navbar -->
        <header class="navbar">
            <div class="logo">
                <a href="/">CR<span>7</span></a>
            </div>
            <nav class="nav-links">
                <a href="/">Inicio</a>
                <a href="/equipos">Equipos</a>
                <a href="/trofeos" class="active">Trofeos</a>
                <a href="/datos">Datos & Stats</a>
            </nav>
        </header>

        <main class="container">
            <section class="page-header">
                <p class="subtitle">PALMARÉS COMPLETO</p>
                <h1>EL LEGADO DE <span class="gold-text">TROFEOS</span></h1>
                <p class="description">
                    Más de 30 títulos colectivos y las distinciones individuales
                    más prestigiosas del fútbol mundial.
                </p>
            </section>

            <!-- Contadores Destacados -->
            <section class="highlights-grid">
                {
                    resumenTrofeos.map((item) => (
                        <div class="highlight-card">
                            <span class="hl-icon">{item.icono}</span>
                            <span class="hl-num">{item.cantidad}</span>
                            <span class="hl-title">{item.titulo}</span>
                        </div>
                    ))
                }
            </section>

            <!-- Premios Individuales -->
            <section class="section-block">
                <h2 class="section-title">
                    <span>🥇</span> Premios Individuales
                </h2>
                <div class="awards-grid">
                    {
                        premiosIndividuales.map((premio) => (
                            <div class="award-card">
                                <div class="award-header">
                                    <span class="award-icon">
                                        {premio.icono}
                                    </span>
                                    <div>
                                        <h3>{premio.nombre}</h3>
                                        <span class="award-count">
                                            {premio.cantidad}x Ganador
                                        </span>
                                    </div>
                                </div>
                                <p class="award-years">
                                    <strong>Años:</strong> {premio.anos}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </section>

            <!-- Títulos con Selección -->
            <section class="section-block">
                <h2 class="section-title">
                    <span>🇵🇹</span> Selección de Portugal
                </h2>
                <div class="national-grid">
                    {
                        titulosSeleccion.map((titulo) => (
                            <div class="national-card">
                                <div class="national-header">
                                    <h3>{titulo.torneo}</h3>
                                    <span class="gold-badge">
                                        {titulo.anos}
                                    </span>
                                </div>
                                <p>{titulo.detalle}</p>
                            </div>
                        ))
                    }
                </div>
            </section>

            <!-- Títulos por Clubes -->
            <section class="section-block">
                <h2 class="section-title">
                    <span>🏆</span> Títulos Colectivos por Club
                </h2>
                <div class="clubs-trophies-grid">
                    {
                        titulosClubes.map((item) => (
                            <div class="club-trophy-card">
                                <div class="club-title">
                                    <span class="club-icon">{item.escudo}</span>
                                    <h3>{item.club}</h3>
                                </div>
                                <ul class="trophy-list">
                                    {item.titulos.map((trofeo) => (
                                        <li>
                                            <span class="trophy-name">
                                                {trofeo.nombre}
                                            </span>
                                            <span class="trophy-badge">
                                                {trofeo.cantidad}x
                                            </span>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        ))
                    }
                </div>
            </section>

            <!-- Navegación Inferior -->
            <div class="bottom-nav">
                <a href="/equipos" class="btn btn-outline">&larr; Ver Equipos</a
                >
                <a href="/datos" class="btn btn-gold"
                    >Explorar Datos & Stats &rarr;</a
                >
            </div>
        </main>

        <footer>
            <p>&copy; 2026 CR7 Fan Page - Creado con Astro</p>
        </footer>
    </body>
</html>

<style>
    /* --- VARIABLES Y COLORES --- */
    :root {
        --cr7-red: #da291c;
        --cr7-gold: #d4af37;
        --cr7-dark: #0a0e17;
        --cr7-card-bg: #141b2d;
        --cr7-text: #ffffff;
        --cr7-text-muted: #a0aec0;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: "Montserrat", sans-serif;
    }

    body {
        background-color: var(--cr7-dark);
        color: var(--cr7-text);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    /* NAVBAR */
    .navbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.5rem 5%;
        background-color: rgba(10, 14, 23, 0.95);
        backdrop-filter: blur(10px);
        position: sticky;
        top: 0;
        z-index: 100;
        border-bottom: 1px solid rgba(212, 175, 55, 0.2);
    }

    .logo a {
        font-size: 2rem;
        font-weight: 900;
        color: var(--cr7-text);
        text-decoration: none;
    }

    .logo span {
        color: var(--cr7-red);
    }

    .nav-links {
        display: flex;
        gap: 2rem;
    }

    .nav-links a {
        color: var(--cr7-text-muted);
        text-decoration: none;
        font-weight: 700;
        font-size: 0.9rem;
        text-transform: uppercase;
        transition: color 0.3s ease;
    }

    .nav-links a:hover,
    .nav-links a.active {
        color: var(--cr7-gold);
    }

    /* CONTAINER */
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 3rem 1.5rem;
        width: 100%;
    }

    .page-header {
        text-align: center;
        margin-bottom: 3.5rem;
    }

    .subtitle {
        color: var(--cr7-red);
        font-weight: 900;
        letter-spacing: 2px;
        font-size: 0.85rem;
        margin-bottom: 0.5rem;
    }

    .page-header h1 {
        font-size: 3rem;
        font-weight: 900;
        text-transform: uppercase;
        margin-bottom: 1rem;
    }

    .gold-text {
        background: linear-gradient(45deg, #d4af37, #fff2a8, #aa7c11);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .description {
        color: var(--cr7-text-muted);
        max-width: 600px;
        margin: 0 auto;
        font-size: 1rem;
    }

    /* HIGHLIGHTS GRID */
    .highlights-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.5rem;
        margin-bottom: 4rem;
    }

    .highlight-card {
        background: linear-gradient(145deg, #182239, #0f172a);
        border: 1px solid rgba(212, 175, 55, 0.3);
        border-radius: 12px;
        padding: 1.5rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    }

    .hl-icon {
        font-size: 2rem;
        margin-bottom: 0.5rem;
    }

    .hl-num {
        font-size: 3rem;
        font-weight: 900;
        color: var(--cr7-gold);
        line-height: 1;
    }

    .hl-title {
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--cr7-text-muted);
        margin-top: 0.5rem;
    }

    /* SECCIONES Y BLOQUES */
    .section-block {
        margin-bottom: 4rem;
    }

    .section-title {
        font-size: 1.6rem;
        font-weight: 900;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.8rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        padding-bottom: 0.8rem;
    }

    /* INDIVIDUAL AWARDS */
    .awards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
    }

    .award-card {
        background-color: var(--cr7-card-bg);
        border-radius: 8px;
        padding: 1.5rem;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .award-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .award-icon {
        font-size: 2rem;
    }

    .award-header h3 {
        font-size: 1.1rem;
        font-weight: 700;
    }

    .award-count {
        color: var(--cr7-gold);
        font-size: 0.85rem;
        font-weight: 700;
    }

    .award-years {
        font-size: 0.85rem;
        color: var(--cr7-text-muted);
    }

    /* NATIONAL SELECTION */
    .national-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.5rem;
    }

    .national-card {
        background-color: var(--cr7-card-bg);
        border-left: 4px solid var(--cr7-red);
        border-radius: 0 8px 8px 0;
        padding: 1.5rem;
    }

    .national-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.8rem;
    }

    .national-header h3 {
        font-size: 1.2rem;
        font-weight: 700;
    }

    .gold-badge {
        background-color: rgba(212, 175, 55, 0.2);
        color: var(--cr7-gold);
        padding: 0.2rem 0.6rem;
        border-radius: 4px;
        font-size: 0.8rem;
        font-weight: 700;
    }

    .national-card p {
        color: var(--cr7-text-muted);
        font-size: 0.9rem;
    }

    /* CLUB TROPHIES */
    .clubs-trophies-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1.5rem;
    }

    .club-trophy-card {
        background-color: var(--cr7-card-bg);
        border-radius: 8px;
        padding: 1.5rem;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .club-title {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        margin-bottom: 1.2rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .club-icon {
        font-size: 1.4rem;
    }

    .club-title h3 {
        font-size: 1.1rem;
        font-weight: 700;
    }

    .trophy-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
    }

    .trophy-list li {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.85rem;
    }

    .trophy-name {
        color: #e2e8f0;
    }

    .trophy-badge {
        background-color: rgba(255, 255, 255, 0.1);
        color: var(--cr7-gold);
        font-weight: 700;
        padding: 0.1rem 0.5rem;
        border-radius: 4px;
        font-size: 0.75rem;
    }

    /* BOTONES */
    .bottom-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 2rem;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        padding: 0.9rem 1.8rem;
        font-size: 0.9rem;
        font-weight: 700;
        border-radius: 4px;
        text-decoration: none;
        text-transform: uppercase;
        transition: all 0.3s ease;
    }

    .btn-gold {
        background: linear-gradient(45deg, #d4af37, #b8860b);
        color: black;
    }

    .btn-outline {
        background: transparent;
        color: white;
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    .btn:hover {
        transform: translateY(-2px);
    }

    /* FOOTER */
    footer {
        text-align: center;
        padding: 2rem;
        background-color: #05070c;
        color: var(--cr7-text-muted);
        font-size: 0.85rem;
        margin-top: auto;
    }

    /* RESPONSIVE */
    @media (max-width: 768px) {
        .navbar {
            flex-direction: column;
            gap: 1rem;
        }

        .page-header h1 {
            font-size: 2.2rem;
        }

        .bottom-nav {
            flex-direction: column;
        }

        .bottom-nav .btn {
            width: 100%;
            justify-content: center;
        }
    }
</style>
