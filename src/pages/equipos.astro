---
const pageTitle = "CR7 - Trayectoria por Equipos";

const equipos = [
{
    id: "portugal",
    nombre: "Selección de Portugal",
    periodo: "2003 - Presente",
    rol: "Capitán y Máximo Goleador Histórico",
    stats: { partidos: 206, goles: 128, asistencias: 46 },
    titulos: ["Eurocopa (2016)", "UEFA Nations League (2019)"],
    color: "#da291c",
    descripcion: "Líder indiscutible y máximo goleador de selecciones en la historia del fútbol internacional. Ha disputado 5 Mundiales y 6 Eurocopas."
},
{
    id: "al-nassr",
    nombre: "Al-Nassr FC",
    periodo: "2023 - Presente",
    rol: "Delantero Centro",
    stats: { partidos: 70, goles: 64, asistencias: 17 },
    titulos: ["Campeonato de Clubes Árabes (2023)"],
    color: "#e2b007",
    descripcion: "Su llegada a Arabia Saudita transformó el fútbol en Oriente Medio, marcando el inicio de una nueva era de estrellas internacionales en la Saudi Pro League."
},
{
    id: "man-utd",
    nombre: "Manchester United",
    periodo: "2003 - 2009 / 2021 - 2022",
    rol: "Extremo / Delantero",
    stats: { partidos: 346, goles: 145, asistencias: 64 },
    titulos: ["3x Premier League", "1x UEFA Champions League", "1x Mundial de Clubes", "1x FA Cup", "2x EFL Cup"],
    color: "#c60c0c",
    descripcion: "Bajo la tutela de Sir Alex Ferguson se convirtió en el mejor jugador del mundo, ganando su primer Balón de Oro y Champions League."
},
{
    id: "real-madrid",
    nombre: "Real Madrid",
    periodo: "2009 - 2018",
    rol: "Máximo Goleador Histórico del Club",
    stats: { partidos: 438, goles: 450, asistencias: 131 },
    titulos: ["4x UEFA Champions League", "2x LaLiga", "3x Mundial de Clubes", "2x Copa del Rey", "3x Supercopa de Europa"],
    color: "#1e3a8a",
    descripcion: "La etapa más gloriosa de su carrera. Promedió más de un gol por partido, ganó 4 Balones de Oro y lideró la era de las 4 Champions en 5 años."
},
{
    id: "juventus",
    nombre: "Juventus FC",
    periodo: "2018 - 2021",
    rol: "Delantero Centro",
    stats: { partidos: 134, goles: 101, asistencias: 22 },
    titulos: ["2x Serie A", "1x Coppa Italia", "2x Supercoppa Italiana"],
    color: "#000000",
    descripcion: "Dominó el fútbol italiano alcanzando la cifra de 100 goles en tiempo récord y ganando el Capocannoniere de la Serie A."
},
{
    id: "sporting",
    nombre: "Sporting CP",
    periodo: "2002 - 2003",
    rol: "Extremo Promesa",
    stats: { partidos: 31, goles: 5, asistencias: 6 },
    titulos: ["Supertaça de Portugal (2002)"],
    color: "#008057",
    descripcion: "Donde todo comenzó. Su deslumbrante actuación en un amistoso contra el Manchester United convenció a Ferguson de ficharlo de inmediato."
}
];
---

<html lang="es">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;700;900&display=swap" rel="stylesheet">
</head>
<body>
    <!-- Navbar -->
    <header class="navbar">
    <div class="logo">
        <a href="/">CR<span>7</span></a>
    </div>
    <nav class="nav-links">
        <a href="/">Inicio</a>
        <a href="/equipos" class="active">Equipos</a>
        <a href="/trofeos">Trofeos</a>
        <a href="/datos">Datos & Stats</a>
    </nav>
    </header>

    <main class="container">
    <section class="page-header">
        <p class="subtitle">TRAYECTORIA DE LEYENDA</p>
        <h1>LOS <span class="gold-text">EQUIPOS</span> DE CR7</h1>
        <p class="description">
        Desde sus inicios en Lisboa hasta conquistar Europa y Asia. Repasa los números y títulos de Cristiano Ronaldo en cada club.
        </p>
    </section>

    <!-- Lista de Equipos Grid -->
    <section class="teams-grid">
        {equipos.map((team) => (
        <article class="team-card" style={`--team-color: ${team.color}`}>
            <div class="card-header">
            <span class="period">{team.periodo}</span>
            <h2>{team.nombre}</h2>
            <p class="role">{team.rol}</p>
            </div>

            <p class="team-desc">{team.descripcion}</p>

            <!-- Stats Rápidas -->
            <div class="stats-box">
            <div class="stat-item">
                <span class="stat-num">{team.stats.partidos}</span>
                <span class="stat-lbl">Partidos</span>
            </div>
            <div class="stat-item">
                <span class="stat-num gold">{team.stats.goles}</span>
                <span class="stat-lbl">Goles</span>
            </div>
            <div class="stat-item">
                <span class="stat-num">{team.stats.asistencias}</span>
                <span class="stat-lbl">Asist.</span>
            </div>
            </div>

            <!-- Títulos Principales -->
            <div class="titles-box">
            <h4>Logros Destacados:</h4>
            <ul>
                {team.titulos.map((titulo) => (
                <li><span>🏆</span> {titulo}</li>
                ))}
            </ul>
            </div>
        </article>
        ))}
    </section>

    <!-- Botón de retorno / Navegación -->
    <div class="bottom-nav">
        <a href="/" class="btn btn-outline">&larr; Volver al Inicio</a>
        <a href="/trofeos" class="btn btn-gold">Ver Todos los Trofeos &rarr;</a>
    </div>
    </main>

    <footer>
    <p>&copy; 2026 CR7 Fan Page - Creado con Astro</p>
    </footer>
</body>
</html>

<style>
  /* --- VARIABLES Y COLORES --- */
:root {
    --cr7-red: #da291c;
    --cr7-gold: #d4af37;
    --cr7-dark: #0a0e17;
    --cr7-card-bg: #141b2d;
    --cr7-text: #ffffff;
    --cr7-text-muted: #a0aec0;
}

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Montserrat', sans-serif;
}

body {
    background-color: var(--cr7-dark);
    color: var(--cr7-text);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

  /* NAVBAR */
.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 5%;
    background-color: rgba(10, 14, 23, 0.95);
    backdrop-filter: blur(10px);
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
}

.logo a {
    font-size: 2rem;
    font-weight: 900;
    color: var(--cr7-text);
    text-decoration: none;
}

.logo span {
    color: var(--cr7-red);
}

.nav-links {
    display: flex;
    gap: 2rem;
}

.nav-links a {
    color: var(--cr7-text-muted);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
    text-transform: uppercase;
    transition: color 0.3s ease;
}
.nav-links a:hover,
.nav-links a.active {
    color: var(--cr7-gold);
}

  /* MAIN CONTAINER */
.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
    width: 100%;
}

.page-header {
    text-align: center;
    margin-bottom: 4rem;
}

.subtitle {
    color: var(--cr7-red);
    font-weight: 900;
    letter-spacing: 2px;
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
}

.page-header h1 {
    font-size: 3rem;
    font-weight: 900;
    text-transform: uppercase;
    margin-bottom: 1rem;
}

.gold-text {
    background: linear-gradient(45deg, #d4af37, #fff2a8, #aa7c11);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.description {
    color: var(--cr7-text-muted);
    max-width: 600px;
    margin: 0 auto;
    font-size: 1rem;
    line-height: 1.6;
}

  /* GRID DE EQUIPOS */
.teams-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
}

.team-card {
    background-color: var(--cr7-card-bg);
    border-radius: 12px;
    padding: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.05);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.3s ease, border-color 0.3s ease;
}

.team-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background-color: var(--team-color);
}

.team-card:hover {
    transform: translateY(-5px);
    border-color: var(--team-color);
}

.card-header .period {
    display: inline-block;
    background-color: rgba(255, 255, 255, 0.08);
    color: var(--cr7-gold);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.3rem 0.8rem;
    border-radius: 20px;
    margin-bottom: 1rem;
}

.card-header h2 {
    font-size: 1.8rem;
    font-weight: 900;
    margin-bottom: 0.3rem;
}

.card-header .role {
    color: var(--cr7-text-muted);
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 1.2rem;
}

.team-desc {
    color: #cbd5e1;
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 1.5rem;
}

  /* STATS BOX */
.stats-box {
    display: flex;
    justify-content: space-around;
    background-color: rgba(0, 0, 0, 0.25);
    padding: 1rem;
    border-radius: 8px;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.03);
}

.stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.stat-num {
    font-size: 1.4rem;
    font-weight: 900;
}

.stat-num.gold {
    color: var(--cr7-gold);
}

.stat-lbl {
    font-size: 0.7rem;
    color: var(--cr7-text-muted);
    text-transform: uppercase;
    margin-top: 0.2rem;
}

  /* TITLES LIST */
.titles-box h4 {
    font-size: 0.85rem;
    text-transform: uppercase;
    color: var(--cr7-text-muted);
    margin-bottom: 0.8rem;
    letter-spacing: 1px;
}

.titles-box ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.titles-box li {
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #e2e8f0;
}

  /* BOTTOM NAVIGATION */
.bottom-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 4rem;
    gap: 1rem;
    flex-wrap: wrap;
}

.btn {
    display: inline-flex;
    align-items: center;
    padding: 0.9rem 1.8rem;
    font-size: 0.9rem;
    font-weight: 700;
    border-radius: 4px;
    text-decoration: none;
    text-transform: uppercase;
    transition: all 0.3s ease;
}

.btn-gold {
    background: linear-gradient(45deg, #d4af37, #b8860b);
    color: black;
}

.btn-outline {
    background: transparent;
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.3);
}

.btn:hover {
    transform: translateY(-2px);
}

  /* FOOTER */
footer {
    text-align: center;
    padding: 2rem;
    background-color: #05070c;
    color: var(--cr7-text-muted);
    font-size: 0.85rem;
    margin-top: auto;
}

  /* RESPONSIVE */
@media (max-width: 768px) {
    .navbar {
    flex-direction: column;
    gap: 1rem;
    }

    .page-header h1 {
    font-size: 2.2rem;
    }

    .bottom-nav {
    flex-direction: column;
    }

    .bottom-nav .btn {
    width: 100%;
    justify-content: center;
    }
}
</style>